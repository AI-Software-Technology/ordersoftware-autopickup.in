{
  "name": "petroflow-backend",
  "version": "1.0.0",
  "description": "PetroFlow Lubricant ERP - REST API (Node.js + Express + MongoDB)",
  "main": "server.js",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node src/scripts/seed.js",
    "seed:reset": "node src/scripts/seed.js --force",
    "migrate:sqlite": "node src/scripts/migrate-sqlite.js",
    "migrate:images": "node src/scripts/migrate-base64-to-disk.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
