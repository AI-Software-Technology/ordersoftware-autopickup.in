# Backend API base URL ( no trailing slash, without /api )
# Local:       http://localhost:9850
# Production:  https://apipetro.imagecloud.online
VITE_API_URL=http://localhost:9850

# Demo accounts panel on the login screen + "Switch Role" in the header.
# Keep false in production: when false, demo accounts and their passwords are NOT part of the build.
VITE_DEMO_MODE=false

# Demo only: auto sign-in when nobody is logged in ( keep false in production ).
# All three values are required for it to work - there are no built-in default credentials.
VITE_DEMO_AUTO_LOGIN=false
# VITE_DEMO_EMAIL=
# VITE_DEMO_PASSWORD=
